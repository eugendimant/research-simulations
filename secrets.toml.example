# ---------------------------------------------------------------------------
# Streamlit secrets template — copy, fill in, and paste. NO REAL KEYS HERE.
# ---------------------------------------------------------------------------
#
# Where this goes:
#
#   Streamlit Community Cloud
#     Open the app at https://share.streamlit.io, pick it, then
#     ⋮ -> Settings -> Secrets, and paste the lines below with your keys
#     filled in. Save; Streamlit restarts the app and picks them up.
#
#   Running locally
#     Copy this file to .streamlit/secrets.toml (that path is git-ignored)
#     and fill in the keys, or export the same names as environment
#     variables before `streamlit run simulation_app/app.py`.
#
# Step-by-step instructions for getting each free key — which page to open,
# what to click, which plan to pick — are in docs/PROVIDER_SETUP.md.
#
# You do NOT need all four. One key (Google AI is the easiest and most
# generous) gives you AI-written open-ended text. With no keys at all the app
# still works: open-ended text comes from the built-in engine instead, and
# numeric data is never affected either way.
#
# Keep a copy of every key in your password manager as you create it. The
# provider will not show you a key again after you close the page, and
# Streamlit's Secrets box will not show you the saved value either.
# ---------------------------------------------------------------------------

# 1. Google AI Studio (Gemini) — start here. https://aistudio.google.com/apikey
GOOGLE_API_KEY = "paste-your-google-ai-studio-key-here"

# 2. Groq — https://console.groq.com/keys
GROQ_API_KEY = "paste-your-groq-key-here"

# 3. SambaNova Cloud — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY = "paste-your-sambanova-key-here"

# 4. OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY = "paste-your-openrouter-key-here"

# ---------------------------------------------------------------------------
# Optional: password-gated pages. With these unset, the pages stay locked,
# which is the intended default.
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD = "choose-a-long-random-password"
# ANALYTICS_DASHBOARD_PASSWORD = "choose-a-different-long-random-password"
