{
 "schema_version": 2,
 "what_this_is": "Distributional reference profiles computed from REAL human item-level responses, for use by realism_benchmark.py. Only aggregate statistics are stored here; no participant-level data is redistributed.",
 "how_tolerances_were_set": "Each tolerance is twice the between-block SD of that metric across the five real BFI blocks, floored at a small minimum. \"Within tolerance\" therefore means \"as close to real data as two real blocks of the same instrument are to each other\", not an arbitrary pass mark.",
 "why_two_variants": "A block of items all keyed in the same direction and a block containing reverse-keyed items have genuinely different marginals: in this data, aligning the reverse-keyed items moves the mean inter-item correlation from 0.096 to 0.363, Cronbach alpha from 0.02 to 0.73, and within-person SD from 1.47 to 1.02. Comparing a simulated all-positive block against the mixed-keying reference would demand an alpha of 0.02, which no instrument should hit. Pick the variant matching whether the block under test contains reverse-keyed items.",
 "provenance": [
  {
   "dataset": "psych::bfi",
   "description": "25 IPIP personality self-report items administered as part of the Synthetic Aperture Personality Assessment (SAPA) web project; 2800 subjects, 6-point agreement scale.",
   "quote": "\"25 personality self report items taken from the International Personality Item Pool (ipip.ori.org) were included as part of the Synthetic Aperture Personality Assessment (SAPA) web based personality assessment project. The data from 2800 subjects are included here as a demonstration set for scale construction, factor analysis, and Item Response Theory analysis.\"",
   "source_page": "https://vincentarelbundock.github.io/Rdatasets/doc/psych/bfi.html",
   "data_file": "https://raw.githubusercontent.com/vincentarelbundock/Rdatasets/master/csv/psych/bfi.csv",
   "distributed_with": "the R package psych (GPL-2 | GPL-3), mirrored by the Rdatasets project",
   "retrieved_on": "2026-10-06",
   "rows_total": 2800,
   "rows_complete_case_used": 2436,
   "reverse_keyed_items": [
    "A1",
    "C4",
    "C5",
    "E1",
    "E2",
    "O2",
    "O5"
   ],
   "reverse_keying_basis": "item wordings read from the package documentation page above: A1 \"Am indifferent to the feelings of others\"; C4 \"Do things in a half-way manner\"; C5 \"Waste my time\"; E1 \"Do not talk a lot\" (administered as \"Don't talk a lot\"); E2 \"Find it difficult to approach others\"; O2 \"Avoid difficult reading material\"; O5 \"Will not probe deeply into a subject\"",
   "caveats": "One self-selected web sample of one instrument family. It pins down the shape of 6-point agreement data well; it is NOT a reference for other scale lengths, other response formats, or economic-game allocations. Adding 5- and 7-point references needs access to data repositories (OSF, Zenodo) that this build could not reach, because the network policy blocks them."
  }
 ],
